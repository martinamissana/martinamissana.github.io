---
import '../styles/global.css';
const { title } = Astro.props;
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>
  <body class="bg-neutral-950 text-white">
    <main class="mx-auto max-w-5xl px-6">
      <slot />
    </main>
  </body>
</html>