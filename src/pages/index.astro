---
import Layout from '../layouts/Layout.astro';
import EEGCanvas from '../components/EEGCanvas.astro';

// Edit this list freely
const skills = [
  'Python',
  'Machine Learning',
  'Deep Learning',
  'Signal Processing',
  'Statistics',
  'EEG & Affective Computing',
];
---
<Layout title="Martina | AI & ML Engineer">
  <!-- Hero -->
  <section class="relative isolate overflow-hidden">
    <!-- Soft forest glow -->
    <div
      class="pointer-events-none absolute inset-0 -z-20 bg-[radial-gradient(ellipse_at_20%_0%,rgba(45,106,79,0.35),transparent_60%)]"
    ></div>
    <!-- Subtle EEG signal in the background -->
    <EEGCanvas />

    <div class="wrap grid items-center gap-12 py-20 md:py-28 lg:grid-cols-[1.2fr_1fr] lg:gap-20">
      <div>
        <p class="text-sm uppercase tracking-[0.25em] text-forest-400">
          AI Engineer &middot; ML Engineer
        </p>
        <h1 class="mt-6 text-5xl font-bold leading-[1.05] tracking-tight md:text-7xl">
          Hi, I'm Martina<span class="text-forest-400">.</span>
        </h1>
        <p class="mt-8 max-w-xl text-lg text-forest-200/70">
          I design, train and evaluate machine learning models, with a strong focus on
          rigorous methodology and solid evaluation. My background is in neurocomputing and
          EEG-based emotion recognition.
        </p>
        <div class="mt-10 flex flex-wrap gap-4">
          <a
            href="#projects"
            class="rounded-full bg-forest-500 px-6 py-3 text-sm font-medium text-forest-100 transition hover:bg-forest-400"
          >See my work</a>
          <a
            href="https://github.com/martinamissana"
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-full border border-line px-6 py-3 text-sm font-medium text-forest-200 transition hover:border-forest-400 hover:text-forest-100"
          >GitHub</a>
          <a
            href="#contact"
            class="rounded-full border border-line px-6 py-3 text-sm font-medium text-forest-200 transition hover:border-forest-400 hover:text-forest-100"
          >Get in touch</a>
        </div>
      </div>

      <!-- Photo: replace /me.svg with your own picture (see instructions) -->
      <div class="relative mx-auto w-full max-w-md lg:max-w-none">
        <div class="absolute -inset-4 -z-10 rounded-[2rem] bg-forest-500/30 blur-3xl"></div>
        <img
          src="/me.jpg"
          alt="Portrait of Martina"
          class="aspect-[4/5] w-full rounded-3xl border border-line object-cover shadow-2xl"
        />
      </div>
    </div>
  </section>

  <!-- About -->
  <section id="about" class="scroll-mt-16 border-y border-line/60 bg-surface/40">
    <div class="wrap grid gap-12 py-20 md:py-24 lg:grid-cols-[1fr_1.4fr]">
      <h2 class="text-3xl font-semibold tracking-tight">About me</h2>
      <div>
        <p class="text-lg text-forest-200/70">
          I’m an AI and machine learning engineer with a background in neurocomputing, driven by mathematical and statistical rigor. 
          My thesis work on EEG-based emotion recognition showed me how easily evaluation pipelines can overstate results, and I like building models whose performance holds up under proper scrutiny. 
          I work mainly in Python, and I’m looking for a role, in industry or research, where I can solve hard problems with strong teams and keep growing.
        </p>
        <ul class="mt-8 flex flex-wrap gap-3">
          {skills.map((skill) => (
            <li class="rounded-full border border-line bg-surface px-4 py-1.5 text-sm text-forest-200">
              {skill}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Projects -->
  <section id="projects" class="scroll-mt-16">
    <div class="wrap py-20 md:py-24">
      <h2 class="text-3xl font-semibold tracking-tight">Projects</h2>
      <p class="mt-3 text-forest-200/60">A few things I've been working on.</p>

      <!-- Placeholder cards: replaced by a content collection in the next step -->
      <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {['Project title', 'Another project', 'A third project'].map((name) => (
          <div class="rounded-2xl border border-line bg-surface p-6 transition hover:-translate-y-1 hover:border-forest-400/60">
            <h3 class="text-xl font-semibold">{name}</h3>
            <p class="mt-2 text-forest-200/60">
              One or two lines on the problem and the approach.
            </p>
            <p class="mt-4 text-xs uppercase tracking-widest text-forest-400">
              Python &middot; ML
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section id="contact" class="scroll-mt-16 border-t border-line/60 bg-surface/40">
    <div class="wrap py-20 text-center md:py-28">
      <h2 class="text-4xl font-bold tracking-tight md:text-5xl">
        Let's talk<span class="text-forest-400">.</span>
      </h2>
      <p class="mx-auto mt-4 max-w-lg text-forest-200/60">
        Open to interesting roles and collaborations in AI and machine learning.
      </p>
      <!-- TODO: replace with your real email -->
      <a
        href="mailto:martinamissana19@gmail.com"
        class="mt-8 inline-block rounded-full bg-forest-500 px-8 py-3 text-sm font-medium text-forest-100 transition hover:bg-forest-400"
      >Say hello</a>
    </div>
  </section>
</Layout>